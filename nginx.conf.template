server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    gzip              on;
    gzip_min_length   512;
    gzip_comp_level   6;
    gzip_types        text/html text/css application/javascript image/svg+xml application/json;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # the page is one file and changes with every deploy: never cache it.
    # add_header does not inherit into a block that sets its own, so the
    # security headers are repeated here rather than only at server level.
    location = /index.html {
        add_header Cache-Control          "no-cache, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    }

    # icons and anything else static: cache hard, they are content-addressed
    # by deploy rather than by name, and a stale icon is harmless
    location ~* \.(svg|png|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
